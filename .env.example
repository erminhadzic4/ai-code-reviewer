# Copy this file to .env and change the values. The .env file is never committed.
# docker compose reads it from this folder; a backend started from backend/ reads it too.

# The password is set when the database volume is first created; changing it later has no
# effect until the volume is removed (docker compose down -v, which deletes all data).
POSTGRES_DB=codereviewer
POSTGRES_USER=codereviewer
POSTGRES_PASSWORD=change-me

# Required: the backend refuses to start with this example value or with fewer than 32
# characters. Generate one with: openssl rand -base64 48
# or in PowerShell: $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=change-me-to-a-long-random-string

# Optional. A free personal access token raises the GitHub API limit from 60 to 5000
# requests an hour. It needs no scopes or permissions: only public repositories are read.
GITHUB_TOKEN=

# Which provider reviews the code: "fake" returns fixed findings and needs no key,
# "gemini" sends the code to a Gemini model and needs GEMINI_API_KEY.
REVIEW_PROVIDER=fake

# Needed only for REVIEW_PROVIDER=gemini. Create the key at https://aistudio.google.com/apikey
# in a Google project WITHOUT billing: the free tier costs nothing, a project with billing is
# charged for every call. On the free tier Google may use the submitted code to improve its
# products; only public repositories are ever sent.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
