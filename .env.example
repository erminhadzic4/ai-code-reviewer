# Copy this file to .env and change the values. The .env file is never committed.

POSTGRES_DB=codereviewer
POSTGRES_USER=codereviewer
POSTGRES_PASSWORD=change-me

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# Optional. A free personal access token raises the GitHub API limit from 60 to 5000
# requests an hour. It needs no scopes or permissions: only public repositories are read.
GITHUB_TOKEN=
